# Copy to .env.local (app) — the reviewer CLI also reads .env.local via dotenv.

# AI reviewer (required for `npm run review`). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model used for video review
# GEMINI_MODEL=gemini-2.5-flash

# Optional: richer metadata + pull a channel's uploads. Without it, single videos still work via oEmbed.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Optional: Supabase. Leave blank to use the local JSON store (data/db.json).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the reviewer/seed scripts to write channels/videos/cards.
SUPABASE_SERVICE_ROLE_KEY=
# Family id to use until auth lands (any uuid; must exist in `families` if using Supabase)
# DEFAULT_FAMILY_ID=00000000-0000-0000-0000-000000000001
