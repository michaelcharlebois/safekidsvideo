# Copy to .env.local (app) — the reviewer CLI also reads .env.local via dotenv.

# AI reviewer (required for `npm run review`). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model used for video review
# GEMINI_MODEL=gemini-3.8-flash

# Optional: richer metadata + pull a channel's uploads. Without it, single videos still work via oEmbed.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Supabase — turns on parent sign-in, device pairing, and multi-family data.
# Leave blank to use the local JSON store (data/db.json) with the PIN-only flow.
# Project settings → API Keys. The publishable key is safe in the browser; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Web push to parent phones. Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects /api/cron/sync. Vercel sets the matching Authorization header on cron calls.
CRON_SECRET=

# Comma-separated emails allowed to edit the shared reviewer notes / run "Learn now". Unset = nobody (local mode: always you).
ADMIN_EMAILS=

# Reviewer cost metering: $ per million tokens (defaults are Flash-class list prices; update as pricing changes) and the nightly discovery cap.
GEMINI_PRICE_IN_PER_M=0.30
GEMINI_PRICE_OUT_PER_M=2.50
DISCOVERY_BUDGET_USD=2

# Billing (optional — leave blank and nobody is ever locked out). Create a recurring Price in Stripe; webhook → /api/stripe/webhook
# with events checkout.session.completed, customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DISPLAY=$7.99 / month
