# STAGING ONLY. Copy to .env.staging on your computer (git-ignored) to run scripts/staging/isolation-check.mjs,
# and enter the same values in the Vercel *staging* project (Settings → Environment Variables). Never put real
# values in git or chat. Every value here must belong to the staging Supabase project or be a staging/test key.

# Supabase: the NEW staging project (brightframe-staging) → Project Settings → API Keys. Never production's.
NEXT_PUBLIC_SUPABASE_URL=https://<staging-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI review: a separate Gemini key for staging if possible (a separate Google Cloud project caps spend), and low budgets.
GEMINI_API_KEY=
DAILY_REVIEW_BUDGET_USD=1
DISCOVERY_BUDGET_USD=0.25

# Real YouTube search and metadata (a separate key keeps staging off production's quota).
YOUTUBE_API_KEY=

# Push: a NEW key pair for staging —  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects the job URLs (≥ 32 random characters, different from production's):  openssl rand -hex 32
CRON_SECRET=

# Who may edit reviewer notes on staging.
ADMIN_EMAILS=

# Billing: leave ALL blank on staging (nobody is ever locked out), or Stripe TEST-mode values only (sk_test_…).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Leave unset on staging: DEMO_KEY, DEMO_PASSWORD, DEMO_EXPIRES, BF_FAKE_NOW, SIFT_LOCAL_DB.
# BF_PERMISSION_WRITES_PAUSED=1 is set only during the rollback rehearsal (runbook §6).
